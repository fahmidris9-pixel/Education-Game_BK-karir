    // =========================================================================
    // 3. ENGINE EFEK SUARA & BACKSOUND MUSIK MENENANGKAN (WEB AUDIO API)
    // =========================================================================
    const AudioFX = {
      ctx: null,
      bgmTimer: null,
      bgmPlaying: false,
      bgmStep: 0,
      init() {
        if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
      },
      playTone(freq, type, duration, delay = 0, gainVal = 0.08) {
        if (!gameState.soundEnabled) return;
        this.init();
        if (!this.ctx) return;
        if (this.ctx.state === 'suspended') this.ctx.resume();

        const now = this.ctx.currentTime + delay;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.linearRampToValueAtTime(gainVal, now + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + duration + 0.03);
      },
      // Musik latar menenangkan ala Harvest Moon: Save the Homeland (Theme III - Pastoral Acoustic)
      startCalmBGM() {
        if (!gameState.soundEnabled || this.bgmPlaying) return;
        this.init();
        this.bgmPlaying = true;
        this.bgmStep = 0;

        const harvestMoonTheme3 = [
          // Birama 1: Gmaj7
          [587.33, 246.94, 196.00],
          [null,   293.66, null],
          [659.25, 369.99, null],
          [587.33, 293.66, null],
          // Birama 2: Em7
          [493.88, 246.94, 164.81],
          [null,   293.66, null],
          [440.00, 329.63, null],
          [392.00, 293.66, null],
          // Birama 3: Cmaj7
          [440.00, 246.94, 130.81],
          [493.88, 261.63, null],
          [587.33, 329.63, null],
          [493.88, 261.63, null],
          // Birama 4: Dsus4 -> D
          [440.00, 220.00, 146.83],
          [null,   293.66, null],
          [392.00, 369.99, null],
          [null,   293.66, null],
          // Birama 5: Gmaj7
          [783.99, 246.94, 196.00],
          [null,   293.66, null],
          [739.99, 369.99, null],
          [659.25, 293.66, null],
          // Birama 6: Bm7
          [587.33, 220.00, 246.94],
          [null,   293.66, null],
          [493.88, 369.99, null],
          [440.00, 293.66, null],
          // Birama 7: Am7 -> D7sus4
          [493.88, 246.94, 220.00],
          [587.33, 261.63, null],
          [493.88, 220.00, 146.83],
          [440.00, 261.63, null],
          // Birama 8: G
          [392.00, 246.94, 196.00],
          [null,   293.66, null],
          [null,   392.00, null],
          [null,   293.66, null]
        ];

        const playStep = () => {
          if (!this.bgmPlaying || !gameState.soundEnabled) return;
          const [melodyFreq, arpFreq, bassFreq] = harvestMoonTheme3[this.bgmStep % harvestMoonTheme3.length];

          if (melodyFreq) {
            this.playTone(melodyFreq, 'sine', 1.25, 0, 0.036);
            this.playTone(melodyFreq * 2, 'sine', 0.55, 0.02, 0.007);
          }

          if (arpFreq) {
            this.playTone(arpFreq, 'triangle', 0.85, 0.01, 0.017);
          }

          if (bassFreq) {
            this.playTone(bassFreq, 'sine', 1.85, 0, 0.032);
          }

          this.bgmStep++;
        };

        playStep();
        this.bgmTimer = setInterval(playStep, 480);
      },
      stopCalmBGM() {
        this.bgmPlaying = false;
        if (this.bgmTimer) {
          clearInterval(this.bgmTimer);
          this.bgmTimer = null;
        }
      },
      sail() {
        this.playTone(330, 'triangle', 0.22, 0);
        this.playTone(440, 'triangle', 0.28, 0.12);
      },
      arrive() {
        this.playTone(523.25, 'sine', 0.16, 0);
        this.playTone(659.25, 'sine', 0.24, 0.1);
      },
      success() {
        this.playTone(587.33, 'triangle', 0.15, 0);
        this.playTone(783.99, 'triangle', 0.25, 0.1);
      },
      wrong() {
        this.playTone(260, 'sawtooth', 0.18, 0);
        this.playTone(210, 'sawtooth', 0.22, 0.12);
      },
      click() {
        this.playTone(620, 'sine', 0.07, 0);
      },
      // Efek tepuk tangan riuh berlapis saat menyelesaikan seluruh quest di Pulau FINISH
      applause() {
        if (!gameState.soundEnabled) return;
        this.init();
        if (!this.ctx) return;
        if (this.ctx.state === 'suspended') this.ctx.resume();

        const now = this.ctx.currentTime;
        const duration = 3.8;
        const clapCount = 135;

        const bufferSize = Math.floor(this.ctx.sampleRate * 0.11);
        const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.28));
        }

        // Lapisan latar gemuruh tepuk tangan audiens yang hangat
        const crowdSize = Math.floor(this.ctx.sampleRate * duration);
        const crowdBuffer = this.ctx.createBuffer(1, crowdSize, this.ctx.sampleRate);
        const crowdData = crowdBuffer.getChannelData(0);
        for (let i = 0; i < crowdSize; i++) {
          crowdData[i] = (Math.random() * 2 - 1);
        }
        const crowdSource = this.ctx.createBufferSource();
        crowdSource.buffer = crowdBuffer;

        const crowdFilter = this.ctx.createBiquadFilter();
        crowdFilter.type = 'bandpass';
        crowdFilter.frequency.setValueAtTime(1150, now);
        crowdFilter.Q.setValueAtTime(0.85, now);

        const crowdGain = this.ctx.createGain();
        crowdGain.gain.setValueAtTime(0.0001, now);
        crowdGain.gain.linearRampToValueAtTime(0.095, now + 0.35);
        crowdGain.gain.setValueAtTime(0.09, now + duration - 0.9);
        crowdGain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        crowdSource.connect(crowdFilter);
        crowdFilter.connect(crowdGain);
        crowdGain.connect(this.ctx.destination);
        crowdSource.start(now);
        crowdSource.stop(now + duration);

        // Tepukan tangan individual yang rapat & meriah
        for (let i = 0; i < clapCount; i++) {
          const progress = i / clapCount;
          const timeOffset = progress * (duration - 0.15) + (Math.random() * 0.08);
          const clapTime = now + timeOffset;

          const source = this.ctx.createBufferSource();
          source.buffer = noiseBuffer;

          const filter = this.ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(850 + Math.random() * 1100, clapTime);
          filter.Q.setValueAtTime(1.1 + Math.random() * 0.9, clapTime);

          const env = progress < 0.12
            ? progress / 0.12
            : progress > 0.72
              ? (1 - progress) / 0.28
              : 1;
          const peakGain = (0.075 + Math.random() * 0.055) * Math.max(0.2, env);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.0001, clapTime);
          gain.gain.linearRampToValueAtTime(peakGain, clapTime + 0.007);
          gain.gain.exponentialRampToValueAtTime(0.0001, clapTime + 0.1);

          source.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);

          source.start(clapTime);
          source.stop(clapTime + 0.105);
        }
      },
      fanfare() {
        const notes = [523.25, 659.25, 783.99, 1046.5, 1318.51];
        notes.forEach((n, i) => this.playTone(n, 'triangle', 0.34, i * 0.11, 0.09));
        this.applause();
      }
    };

