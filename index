              ${hollandCode}
            </div>
            <div class="mt-1.5">${quizSummaryHtml}</div>
          </div>
        </div>

        <div>
          <h4 class="font-display font-bold text-base sm:text-lg text-slate-800 mb-2.5">
            🌟 3 Tipe Kepribadian Dominan Kamu (${hollandCode})
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            ${topThree
              .map(
                (t, rank) => `
                <div class="rounded-2xl p-4 border-2 border-slate-800 bg-white shadow-sm flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-300 border border-slate-800">#${
                        rank + 1
                      } Dominan</span>
                      <span class="font-display font-bold text-lg text-slate-900">${gameState.scores[t.code]}%</span>
                    </div>
                    <h5 class="font-display font-bold text-base text-slate-900">${t.code} - ${t.name}</h5>
                    <p class="text-xs text-slate-600 mt-1 mb-3 leading-relaxed">${t.description}</p>
                  </div>
                  <div class="space-y-2 pt-2 border-t border-slate-200 text-xs">
                    <div>
                      <span class="font-bold text-slate-800 block">🎓 Rekomendasi Jurusan:</span>
                      <ul class="list-disc list-inside text-slate-700 mt-0.5">
                        ${t.majors.map((m) => `<li>${m}</li>`).join('')}
                      </ul>
                    </div>
                    <div>
                      <span class="font-bold text-slate-800 block">💼 Rekomendasi Karier:</span>
                      <ul class="list-disc list-inside text-slate-700 mt-0.5">
                        ${t.careers.map((c) => `<li>${c}</li>`).join('')}
                      </ul>
                    </div>
                  </div>
                </div>
              `
              )
              .join('')}
          </div>
        </div>

        <div class="bg-slate-50 rounded-2xl p-4 border-2 border-slate-200 space-y-2.5">
          <h4 class="font-display font-bold text-sm sm:text-base text-slate-800">
            📊 Grafik Persentase Seluruh Tipe RIASEC
          </h4>
          ${sortedTypes
            .map((t) => {
              const pct = gameState.scores[t.code] || 0;
              return `
                <div>
                  <div class="flex justify-between text-xs font-bold text-slate-800 mb-1">
                    <span>${t.code} — ${t.name}</span>
                    <span>${pct}%</span>
                  </div>
                  <div class="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden border border-slate-800">
                    <div class="h-full ${t.barColor} transition-all duration-500" style="width: ${pct}%"></div>
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>

        <div class="pt-2 text-center border-t border-slate-200">
          <p class="text-xs font-semibold text-slate-600">
            Media Game Edukasi Bimbingan & Konseling • Dikembangkan oleh <strong class="text-slate-800">Fahmi Idris, S.Pd</strong>
          </p>
        </div>
      `;

      showModal('result-modal');
      AudioFX.fanfare();
      launchConfetti();
    }

    window.closeResultModal = function () {
      AudioFX.click();
      hideModal('result-modal');
      stopConfetti();
    };

    window.printCareerReport = function () {
      AudioFX.click();
      window.print();
    };

    window.resetGame = function () {
      AudioFX.stopCalmBGM();
      AudioFX.click();
      stopConfetti();

      gameState.currentStep = 0;
      gameState.completedSteps = new Set([0]);
      gameState.scores = { R: 0, I: 0, A: 0, S: 0, E: 0, C: 0 };
      gameState.quizAnswers = {};
      gameState.interestAnswers = {};
      gameState.isSailing = false;

      const ship = document.getElementById('player-ship');
      if (ship) {
        ship.setAttribute('transform', `translate(${SHIP_WAYPOINTS[0].x}, ${SHIP_WAYPOINTS[0].y})`);
      }

      hideModal('result-modal');
      hideModal('island-modal');
      hideModal('start-brief-modal');
      hideModal('welcome-modal');
      updateHUD();
      showModal('identity-modal');
    };

    // =========================================================================
    // 9. ANIMASI KONFETI PERAYAAN FINISH
    // =========================================================================
    function launchConfetti() {
      const canvas = document.getElementById('confetti-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#facc15', '#38bdf8', '#4ade80', '#fb7185', '#a855f7', '#fb923c'];
      const pieces = Array.from({ length: 90 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: 8 + Math.random() * 6,
        h: 6 + Math.random() * 6,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: 2.2 + Math.random() * 3.2,
        vx: -1.5 + Math.random() * 3,
        rot: Math.random() * Math.PI * 2,
        vrot: -0.08 + Math.random() * 0.16
      }));

      const endTime = performance.now() + 4500;

      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          if (p.y > canvas.height) p.y = -12;

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });

        if (now < endTime) {
          gameState.confettiRafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }

      stopConfetti();
      gameState.confettiRafId = requestAnimationFrame(frame);
    }

    function stopConfetti() {
      if (gameState.confettiRafId) {
        cancelAnimationFrame(gameState.confettiRafId);
        gameState.confettiRafId = null;
      }
      const canvas = document.getElementById('confetti-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    // =========================================================================
    // 10. INISIALISASI EVENT LISTENER SAAT HALAMAN DIMUAT
    // =========================================================================
    document.addEventListener('DOMContentLoaded', () => {
      updateHUD();

      const btnSound = document.getElementById('btn-sound');
      if (btnSound) {
        btnSound.addEventListener('click', () => {
          gameState.soundEnabled = !gameState.soundEnabled;
          btnSound.textContent = gameState.soundEnabled ? '🔊' : '🔇';
          if (!gameState.soundEnabled) {
            AudioFX.stopCalmBGM();
          } else {
            AudioFX.click();
            const islandModal = document.getElementById('island-modal');
            if (islandModal && islandModal.classList.contains('is-open')) {
              AudioFX.startCalmBGM();
            }
          }
        });
      }

      const btnHome = document.getElementById('btn-home');
      if (btnHome) {
        btnHome.addEventListener('click', () => {
          window.resetGame();
        });
      }

      const nameInput = document.getElementById('input-student-name');
      const classInput = document.getElementById('input-student-class');
      [nameInput, classInput].forEach((inp) => {
        if (inp) {
          inp.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              window.submitIdentityPopup();
            }
          });
        }
      });
    });
  </script>
</body>
</html>
