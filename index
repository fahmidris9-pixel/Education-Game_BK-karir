<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Petualangan Kepulauan RIASEC - Teori Karier Holland</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ocean-bg: #5ac8d8;
      --ocean-deep: #3eb2c4;
      --ink: #1e293b;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #4cc3d4;
      color: var(--ink);
      overflow-x: hidden;
      user-select: none;
    }

    h1, h2, h3, .font-display {
      font-family: 'Fredoka', sans-serif;
    }

    /* Animasi Ombak, Denyut Tombol & Elemen Peta */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }

    @keyframes waveShift {
      0%, 100% { transform: translateX(0px); }
      50% { transform: translateX(8px); }
    }

    @keyframes pulseGlow {
      0%, 100% { filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.8)); }
      50% { filter: drop-shadow(0 0 20px rgba(250, 204, 21, 1)); }
    }

    @keyframes bounceShip {
      0%, 100% { transform: translateY(0) rotate(-2deg); }
      50% { transform: translateY(-5px) rotate(2deg); }
    }

    @keyframes btnPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }

    .island-group {
      cursor: pointer;
      transition: filter 0.2s ease, opacity 0.2s ease;
    }

    .island-group * {
      pointer-events: none;
    }

    .island-group .island-hitbox {
      pointer-events: all;
      cursor: pointer;
    }

    .island-group:hover {
      filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.95)) drop-shadow(0 8px 8px rgba(15, 23, 42, 0.35));
    }

    .island-active {
      animation: pulseGlow 2s infinite ease-in-out;
    }

    .sea-decor {
      pointer-events: none;
    }

    .ship-bob {
      animation: bounceShip 2.4s infinite ease-in-out;
      transform-box: fill-box;
      transform-origin: center;
    }

    .wave-anim {
      animation: waveShift 4s infinite ease-in-out;
    }

    .pulse-cta {
      animation: btnPulse 1.8s infinite ease-in-out;
    }

    /* Manajemen Overlay Modal agar tidak pernah memblokir klik saat tertutup */
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      background-color: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      overflow-y: auto;
      pointer-events: none;
    }

    .modal-overlay.is-open {
      display: flex;
      pointer-events: auto;
    }

    /* Custom Scrollbar & Pengunci Scroll Anchor untuk Modal */
    #modal-body-content,
    .question-card {
      overflow-anchor: none;
    }

    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #94a3b8;
      border-radius: 999px;
    }

    /* Kartu Timbul Gaya Board Game */
    .board-card {
      border: 3px solid #1e293b;
      box-shadow: 0 6px 0 #1e293b;
    }

    .board-btn {
      border: 2.5px solid #1e293b;
      box-shadow: 0 4px 0 #1e293b;
      transition: all 0.12s ease;
      cursor: pointer;
    }

    .board-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 #1e293b;
    }

    .board-btn:active:not(:disabled) {
      transform: translateY(2px);
      box-shadow: 0 2px 0 #1e293b;
    }

    /* Gaya Tombol Pilihan Jawaban & Skala Minat (Tanpa Radio Input) */
    .option-choice-btn.selected {
      background-color: #fde047 !important;
      border-color: #1e293b !important;
      box-shadow: 0 3px 0 #1e293b;
      color: #0f172a !important;
    }

    .quiz-choice-btn.selected {
      background-color: #bae6fd !important;
      border-color: #1e293b !important;
      box-shadow: 0 3px 0 #1e293b;
      font-weight: 700;
    }

    /* Styling Khusus Cetak / Simpan PDF Laporan */
    @media print {
      body {
        background: #ffffff !important;
        overflow: visible !important;
      }
      header, main, #identity-modal, #welcome-modal, #start-brief-modal, #island-modal, #guide-modal, #confetti-canvas, .no-print {
        display: none !important;
      }
      #result-modal {
        position: static !important;
        display: block !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        background: transparent !important;
        padding: 0 !important;
      }
      #result-modal > div {
        max-width: 100% !important;
        max-height: none !important;
        box-shadow: none !important;
        border: 2px solid #1e293b !important;
      }
      #result-body-content {
        overflow: visible !important;
        max-height: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-gradient-to-b from-[#67d5e6] via-[#53c4d6] to-[#3fb0c2]">

  <!-- Canvas Konfeti untuk Perayaan Finish -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

  <!-- Header / HUD Navigasi Atas -->
  <header class="w-full max-w-7xl mx-auto px-3 sm:px-6 pt-3 pb-2 z-20 relative">
    <div class="bg-white/95 backdrop-blur-md rounded-2xl px-4 py-2.5 board-card flex flex-wrap items-center justify-between gap-3">
      <!-- Judul & Identitas Siswa -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-amber-400 border-2 border-slate-800 flex items-center justify-center text-xl shadow-sm shrink-0">
          🧭
        </div>
        <div>
          <h1 class="text-base sm:text-xl font-bold text-slate-800 leading-tight">
            Petualangan Kepulauan RIASEC
          </h1>
          <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
            <span id="hud-student-badge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold bg-emerald-100 text-emerald-900 border border-slate-800">
              👤 Kapten: Belum Diisi
            </span>
            <span id="hud-class-badge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold bg-amber-100 text-amber-900 border border-slate-800">
              🏫 Kelas: -
            </span>
            <span id="hud-progress-count" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold bg-sky-100 text-sky-900 border border-slate-800">
              🏝️ 0/6 Pulau
            </span>
          </div>
        </div>
      </div>

      <!-- Indikator Progres Pulau -->
      <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto py-1" id="progress-tracker" aria-label="Progres Pulau">
        <!-- Diisi oleh JavaScript -->
      </div>

      <!-- Kontrol Mode, Audio & Reset -->
      <div class="flex items-center gap-2">
        <span id="mode-badge" class="hidden lg:inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border-2 border-slate-800">
          Mode: Eksplorasi & Kuis
        </span>
        <button type="button" onclick="window.openGuideModal('tujuan')" title="Tujuan & Petunjuk Bermain" class="px-2.5 sm:px-3 py-2 rounded-xl bg-sky-100 hover:bg-sky-200 text-slate-800 board-btn text-xs sm:text-sm font-bold flex items-center gap-1">
          <span>🎯</span><span class="hidden sm:inline">Tujuan & Petunjuk</span>
        </button>
        <button type="button" id="btn-sound" title="Suara Efek & Musik Latar" class="p-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-slate-800 board-btn text-sm font-bold" aria-label="Toggle Suara">
          🔊
        </button>
        <button type="button" id="btn-home" title="Reset / Ganti Siswa" class="px-3 py-2 rounded-xl bg-rose-100 hover:bg-rose-200 text-slate-800 board-btn text-xs sm:text-sm font-bold">
          🔄 Ganti Siswa
        </button>
      </div>
    </div>
  </header>

  <!-- Area Utama Peta Kepulauan -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 py-2 flex flex-col items-center justify-center relative z-10">
    
    <!-- Container Peta Responsif -->
    <div id="map-wrapper" class="w-full bg-[#5ecce0] rounded-3xl board-card overflow-hidden relative shadow-2xl">
      
      <!-- Banner Petunjuk Aksi di Atas Peta -->
      <div class="bg-amber-50/95 border-b-2 border-slate-800 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 border border-slate-800 animate-ping shrink-0"></span>
          <p id="status-instruction" class="text-xs sm:text-sm font-semibold text-slate-800">
            Selamat datang Kapten! Kapal bersandar di Pulau START. Klik "Mulai Berlayar ke Pulau R".
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="btn-next-action" onclick="window.handlePrimaryBannerAction()" class="px-4 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-900 font-display font-bold text-xs sm:text-sm board-btn pulse-cta">
            ⛵ Mulai Berlayar ke Pulau R
          </button>
        </div>
      </div>

      <!-- SVG Peta Kepulauan RIASEC 16:9 (8 Pulau + Dekorasi Laut + Kapal Pemain) -->
      <div class="w-full overflow-x-auto">
        <svg id="island-map-svg" viewBox="0 0 1200 675" class="w-full h-auto min-w-[760px] block" role="img" aria-label="Peta Kepulauan Teori Karier Holland RIASEC">
          <defs>
            <!-- Pola Tekstur Air Laut -->
            <pattern id="sea-pattern" width="120" height="120" patternUnits="userSpaceOnUse">
              <rect width="120" height="120" fill="#5ecce0" />
              <path d="M15 30 Q22 24 30 30 T45 30" fill="none" stroke="#3aa8bd" stroke-width="2.2" stroke-linecap="round" opacity="0.55" />
              <path d="M75 85 Q82 79 90 85 T105 85" fill="none" stroke="#3aa8bd" stroke-width="2.2" stroke-linecap="round" opacity="0.55" />
            </pattern>

            <!-- Gradien Medali Emas -->
            <linearGradient id="coin-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#fde047" />
              <stop offset="50%" stop-color="#facc15" />
              <stop offset="100%" stop-color="#eab308" />
            </linearGradient>

            <!-- Drop Shadow Pulau -->
            <filter id="island-shadow" x="-10%" y="-10%" width="125%" height="125%">
              <feDropShadow dx="0" dy="8" stdDeviation="4" flood-color="#1e4e5f" flood-opacity="0.35" />
            </filter>
          </defs>

          <!-- Latar Laut Bersih -->
          <rect width="1200" height="675" fill="url(#sea-pattern)" class="sea-decor" />

          <!-- Dekorasi Laut -->
          <g class="wave-anim sea-decor" opacity="0.78">
            <path d="M360 68 Q370 60 380 68 T400 68" fill="none" stroke="#2c8fa3" stroke-width="2.5" stroke-linecap="round" />
            <path d="M770 62 Q780 54 790 62 T810 62" fill="none" stroke="#2c8fa3" stroke-width="2.5" stroke-linecap="round" />
            <path d="M430 338 Q440 330 450 338 T470 338" fill="none" stroke="#2c8fa3" stroke-width="2.5" stroke-linecap="round" />
            <path d="M780 348 Q790 340 800 348 T820 348" fill="none" stroke="#2c8fa3" stroke-width="2.5" stroke-linecap="round" />
            <path d="M370 610 Q380 602 390 610 T410 610" fill="none" stroke="#2c8fa3" stroke-width="2.5" stroke-linecap="round" />
            <!-- Sirip Hiu Lucu -->
            <g transform="translate(835, 35)">
              <path d="M 4 20 Q 14 4 22 6 Q 18 14 24 20 Z" fill="#64748b" stroke="#1e293b" stroke-width="2" />
              <path d="M 0 21 Q 14 18 28 21" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
            </g>
          </g>

          <!-- Pulau Kecil Dekoratif di Tengah -->
          <g class="sea-decor" transform="translate(765, 312)">
            <ellipse cx="35" cy="36" rx="34" ry="14" fill="#a16207" stroke="#1e293b" stroke-width="2.5" />
            <ellipse cx="35" cy="31" rx="32" ry="12" fill="#fde047" stroke="#1e293b" stroke-width="2.5" />
            <polygon points="15,28 28,6 41,28" fill="#64748b" stroke="#1e293b" stroke-width="2.2" />
            <polygon points="28,6 23,15 33,15" fill="#ffffff" stroke="#1e293b" stroke-width="1.5" />
            <polygon points="34,29 46,9 58,29" fill="#475569" stroke="#1e293b" stroke-width="2.2" />
            <polygon points="46,9 41,17 51,17" fill="#ffffff" stroke="#1e293b" stroke-width="1.5" />
            <circle cx="24" cy="24" r="5" fill="#22c55e" stroke="#1e293b" stroke-width="2" />
          </g>

          <!-- Karang & Kerang Dekoratif -->
          <g class="sea-decor" transform="translate(45, 328)">
            <ellipse cx="22" cy="35" rx="16" ry="6" fill="#fde047" stroke="#1e293b" stroke-width="2" />
            <path d="M18 33 L12 16 M22 33 L22 12 M26 33 L32 18" stroke="#f43f5e" stroke-width="5" stroke-linecap="round" />
            <path d="M18 33 L12 16 M22 33 L22 12 M26 33 L32 18" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none" />
          </g>
          <g class="sea-decor" transform="translate(38, 592)">
            <path d="M12 35 L6 16 M18 35 L18 12 M24 35 L30 18" stroke="#fb7185" stroke-width="5" stroke-linecap="round" />
            <circle cx="48" cy="32" r="9" fill="#f9a8d4" stroke="#1e293b" stroke-width="2" />
          </g>

          <!-- Pegunungan Latar Sudut Kanan Atas -->
          <g class="sea-decor" transform="translate(1090, 22)">
            <polygon points="10,45 30,10 50,45" fill="#64748b" stroke="#1e293b" stroke-width="2.5" />
            <polygon points="30,10 22,24 38,24" fill="#f8fafc" stroke="#1e293b" stroke-width="2" />
            <polygon points="38,48 56,16 74,48" fill="#475569" stroke="#1e293b" stroke-width="2.5" />
            <polygon points="56,16 49,28 63,28" fill="#f8fafc" stroke="#1e293b" stroke-width="2" />
          </g>

          <!-- Perahu Layar Hiasan Latar -->
          <g class="sea-decor" transform="translate(415, 32)" opacity="0.88">
            <polygon points="22,4 22,26 8,26" fill="#ffffff" stroke="#1e293b" stroke-width="2" />
            <polygon points="25,8 25,26 37,26" fill="#fed7aa" stroke="#1e293b" stroke-width="2" />
            <polygon points="4,28 40,28 34,36 10,36" fill="#ea580c" stroke="#1e293b" stroke-width="2" />
          </g>
          <g class="sea-decor" transform="translate(825, 596)" opacity="0.88">
            <polygon points="22,4 22,26 8,26" fill="#ffffff" stroke="#1e293b" stroke-width="2" />
            <polygon points="25,8 25,26 37,26" fill="#bae6fd" stroke="#1e293b" stroke-width="2" />
            <polygon points="4,28 40,28 34,36 10,36" fill="#dc2626" stroke="#1e293b" stroke-width="2" />
          </g>

          <!-- Layer Dinamis Titik Jejak Pelayaran Setelah Melewati Pulau -->
          <g id="voyage-trail-layer" class="sea-decor"></g>

          <!-- ========================================================= -->
          <!-- PULAU 0: START (Sudut Kiri Atas - Mercusuar & Dermaga)     -->
          <!-- ========================================================= -->
          <g id="island-0" class="island-group" data-step="0" onclick="window.handleIslandClick(0)" transform="translate(18, 16)" filter="url(#island-shadow)">
            <rect class="island-hitbox" x="6" y="4" width="160" height="140" rx="28" fill="transparent" />
            <ellipse cx="86" cy="102" rx="78" ry="48" fill="#a5f3fc" opacity="0.7" />
            <path d="M 16 90 C 13 128, 159 128, 156 90 L 156 76 L 16 76 Z" fill="#92400e" stroke="#1e293b" stroke-width="3" />
            <ellipse cx="86" cy="76" rx="70" ry="36" fill="#86efac" stroke="#1e293b" stroke-width="3" />
            <ellipse cx="96" cy="84" rx="46" ry="20" fill="#fde047" stroke="#1e293b" stroke-width="2.2" />
            
            <!-- Dermaga Kayu -->
            <g transform="translate(108, 86) rotate(18)">
              <rect x="0" y="0" width="40" height="16" rx="2" fill="#b45309" stroke="#1e293b" stroke-width="2.2" />
              <line x1="10" y1="0" x2="10" y2="16" stroke="#1e293b" stroke-width="2" />
              <line x1="20" y1="0" x2="20" y2="16" stroke="#1e293b" stroke-width="2" />
              <line x1="30" y1="0" x2="30" y2="16" stroke="#1e293b" stroke-width="2" />
            </g>

            <!-- Mercusuar Merah-Putih -->
            <g transform="translate(36, 12)">
              <polygon points="10,54 15,18 29,18 34,54" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" />
              <polygon points="12,42 32,42 30,32 14,32" fill="#ef4444" stroke="#1e293b" stroke-width="2" />
              <polygon points="14,24 30,24 29,18 15,18" fill="#ef4444" stroke="#1e293b" stroke-width="2" />
              <rect x="13" y="10" width="18" height="8" rx="1" fill="#fef08a" stroke="#1e293b" stroke-width="2" />
              <polygon points="11,10 22,2 33,10" fill="#dc2626" stroke="#1e293b" stroke-width="2.2" />
            </g>

            <!-- Papan Penunjuk Arah -->
            <g transform="translate(76, 34)">
              <rect x="6" y="0" width="4" height="26" fill="#78350f" stroke="#1e293b" stroke-width="1.8" />
              <polygon points="0,4 16,4 20,8 16,12 0,12" fill="#fb923c" stroke="#1e293b" stroke-width="1.8" />
              <polygon points="16,14 2,14 -2,18 2,22 16,22" fill="#facc15" stroke="#1e293b" stroke-width="1.8" />
            </g>

            <!-- Plakat START -->
            <rect x="44" y="76" width="80" height="22" rx="11" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" />
            <text x="84" y="92" text-anchor="middle" font-family="Fredoka, sans-serif" font-weight="700" font-size="13" fill="#1e293b">START</text>

            <!-- Tombol Aksi Langsung "Mulai Berlayar" di Pulau START -->
            <g id="svg-start-cta" class="pulse-cta">
              <rect x="18" y="106" width="136" height="28" rx="14" fill="#facc15" stroke="#1e293b" stroke-width="2.6" />
              <text x="86" y="125" text-anchor="middle" font-family="Fredoka, sans-serif" font-weight="700" font-size="13" fill="#1e293b">⛵ Mulai Berlayar</text>
            </g>
          </g>

          <!-- ========================================================= -->
          <!-- PULAU 1: R - REALISTIC (Bengkel, Roda Gigi, Alat Teknik)  -->
          <!-- ========================================================= -->
          <g id="island-1" class="island-group" data-step="1" onclick="window.handleIslandClick(1)" transform="translate(158, 65)" filter="url(#island-shadow)">
            <rect class="island-hitbox" x="8" y="8" width="254" height="202" rx="48" fill="transparent" />
            <ellipse cx="135" cy="138" rx="126" ry="72" fill="#a5f3fc" opacity="0.55" />
            <path d="M 22 122 C 18 182, 252 182, 248 122 L 248 106 L 22 106 Z" fill="#92400e" stroke="#1e293b" stroke-width="3" />
            <path d="M 24 114 C 22 168, 248 168, 246 114 Z" fill="#fde68a" stroke="#1e293b" stroke-width="2.5" />
            <ellipse cx="135" cy="105" rx="114" ry="58" fill="#14b8a6" stroke="#1e293b" stroke-width="3" />

            <!-- Roda Gigi Besar -->
            <g transform="translate(72, 16)">
              <circle cx="32" cy="32" r="24" fill="#94a3b8" stroke="#1e293b" stroke-width="3" />
              <circle cx="32" cy="32" r="10" fill="#14b8a6" stroke="#1e293b" stroke-width="2.5" />
              <rect x="28" y="2" width="8" height="8" fill="#94a3b8" stroke="#1e293b" stroke-width="2" />
              <rect x="28" y="54" width="8" height="8" fill="#94a3b8" stroke="#1e293b" stroke-width="2" />
              <rect x="2" y="28" width="8" height="8" fill="#94a3b8" stroke="#1e293b" stroke-width="2" />
              <rect x="54" y="28" width="8" height="8" fill="#94a3b8" stroke="#1e293b" stroke-width="2" />
            </g>
            <!-- Roda Gigi Oranye -->
            <g transform="translate(42, 48)">
              <circle cx="20" cy="20" r="15" fill="#f59e0b" stroke="#1e293b" stroke-width="2.5" />
              <circle cx="20" cy="20" r="6" fill="#14b8a6" stroke="#1e293b" stroke-width="2" />
            </g>

            <!-- Bengkel / Garasi -->
            <g transform="translate(132, 34)">
              <rect x="64" y="0" width="12" height="26" fill="#fb923c" stroke="#1e293b" stroke-width="2.5" />
              <polygon points="0,34 42,10 84,34" fill="#fdba74" stroke="#1e293b" stroke-width="2.8" />
              <rect x="8" y="34" width="68" height="42" fill="#fed7aa" stroke="#1e293b" stroke-width="2.8" />
              <rect x="20" y="46" width="44" height="30" fill="#475569" stroke="#1e293b" stroke-width="2.2" />
              <rect x="28" y="60" width="28" height="12" rx="3" fill="#f97316" stroke="#1e293b" stroke-width="2" />
              <circle cx="34" cy="73" r="4" fill="#1e293b" />
              <circle cx="50" cy="73" r="4" fill="#1e293b" />
            </g>

            <!-- Ekskavator & Kunci Pas -->
            <g transform="translate(55, 114)">
              <rect x="0" y="10" width="38" height="14" rx="4" fill="#facc15" stroke="#1e293b" stroke-width="2.2" />
              <rect x="22" y="2" width="14" height="10" rx="2" fill="#38bdf8" stroke="#1e293b" stroke-width="2" />
              <circle cx="10" cy="25" r="6" fill="#334155" stroke="#1e293b" stroke-width="2" />
              <circle cx="30" cy="25" r="6" fill="#334155" stroke="#1e293b" stroke-width="2" />
            </g>
