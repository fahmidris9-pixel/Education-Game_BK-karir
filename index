    // =========================================================================
    // 5. UPDATE HUD, PROGRESS BAR, PETA & JEJAK PELAYARAN
    // =========================================================================
    function updateHUD() {
      const nameBadge = document.getElementById('hud-student-badge');
      const classBadge = document.getElementById('hud-class-badge');
      const progBadge = document.getElementById('hud-progress-count');
      const modeBadge = document.getElementById('mode-badge');

      if (nameBadge) {
        nameBadge.textContent = `👤 Kapten: ${gameState.studentName || 'Belum Diisi'}`;
      }
      if (classBadge) {
        classBadge.textContent = `🏫 Kelas: ${gameState.studentClass || '-'}`;
      }

      const completedRIASEC = [1, 2, 3, 4, 5, 6].filter((s) => gameState.completedSteps.has(s)).length;
      if (progBadge) {
        progBadge.textContent = `🏝️ ${completedRIASEC}/6 Pulau`;
      }

      if (modeBadge) {
        modeBadge.textContent =
          gameState.mode === 'explore' ? 'Mode: Eksplorasi & Kuis' : 'Mode: Tes Minat Cepat';
      }

      renderProgressTracker();
      updateMapVisuals();
      updateBannerInstruction();
    }

    function renderProgressTracker() {
      const container = document.getElementById('progress-tracker');
      if (!container) return;

      const steps = [
        { step: 0, label: 'START' },
        { step: 1, label: 'R' },
        { step: 2, label: 'I' },
        { step: 3, label: 'A' },
        { step: 4, label: 'S' },
        { step: 5, label: 'E' },
        { step: 6, label: 'C' },
        { step: 7, label: 'FINISH' }
      ];

      container.innerHTML = steps
        .map((item) => {
          const isDone = gameState.completedSteps.has(item.step);
          const isCurrent = gameState.currentStep === item.step;
          const maxUnlocked = Math.max(...Array.from(gameState.completedSteps)) + 1;
          const isUnlocked = item.step <= maxUnlocked;

          let cls = 'px-2.5 py-1 rounded-xl text-xs font-display font-bold border-2 transition-all shrink-0 ';
          if (isCurrent) {
            cls += 'bg-amber-400 border-slate-900 text-slate-900 scale-105 shadow-sm';
          } else if (isDone) {
            cls += 'bg-emerald-300 border-slate-800 text-slate-900';
          } else if (isUnlocked) {
            cls += 'bg-white border-slate-800 text-slate-800 hover:bg-amber-100';
          } else {
            cls += 'bg-slate-200/80 border-slate-400 text-slate-500 opacity-70 cursor-not-allowed';
          }

          return `<button type="button" onclick="window.handleIslandClick(${item.step})" class="${cls}">${
            isDone && item.step >= 1 && item.step <= 6 ? `${item.label} ✓` : item.label
          }</button>`;
        })
        .join('');
    }

    function updateMapVisuals() {
      const maxUnlocked = Math.max(...Array.from(gameState.completedSteps)) + 1;

      for (let step = 0; step <= 7; step++) {
        const group = document.getElementById(`island-${step}`);
        if (!group) continue;

        const isDone = gameState.completedSteps.has(step);
        const isNextTarget = step === maxUnlocked && step <= 7;

        group.classList.toggle('island-active', isNextTarget);
        group.style.opacity = step <= maxUnlocked ? '1' : '0.72';

        if (step >= 1 && step <= 6) {
          const coinBg = document.getElementById(`coin-bg-${step}`);
          const coinText = document.getElementById(`coin-text-${step}`);
          const islandObj = RIASEC_DATA[step - 1];
          if (coinBg && coinText && islandObj) {
            if (isDone) {
              coinBg.setAttribute('fill', '#4ade80');
              coinText.textContent = '✓';
              coinText.setAttribute('fill', '#064e3b');
            } else {
              coinBg.setAttribute('fill', 'url(#coin-grad)');
              coinText.textContent = islandObj.code;
              coinText.setAttribute('fill', '#78350f');
            }
          }
        }
      }

      const startCta = document.getElementById('svg-start-cta');
      if (startCta) {
        startCta.style.display = gameState.currentStep === 0 ? 'block' : 'none';
      }

      renderVoyageTrail();
    }

    function renderVoyageTrail() {
      const trailLayer = document.getElementById('voyage-trail-layer');
      if (!trailLayer) return;

      const completedSorted = Array.from(gameState.completedSteps).sort((a, b) => a - b);
      const maxReached = Math.max(gameState.currentStep, ...completedSorted);

      let dotsSvg = '';
      for (let s = 0; s < maxReached; s++) {
        const from = SHIP_WAYPOINTS[s];
        const to = SHIP_WAYPOINTS[s + 1];
        if (!from || !to) continue;

        const ctrlX = (from.x + to.x) / 2;
        const ctrlY = Math.min(from.y, to.y) - 36;
        const dotCount = 7;

        for (let i = 1; i < dotCount; i++) {
          const t = i / dotCount;
          const x = (1 - t) * (1 - t) * from.x + 2 * (1 - t) * t * ctrlX + t * t * to.x;
          const y = (1 - t) * (1 - t) * from.y + 2 * (1 - t) * t * ctrlY + t * t * to.y;
          dotsSvg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="4.2" fill="#ffffff" stroke="#1e293b" stroke-width="1.6" opacity="0.92" />`;
        }
      }

      trailLayer.innerHTML = dotsSvg;
    }

    function updateBannerInstruction() {
      const textEl = document.getElementById('status-instruction');
      const btnEl = document.getElementById('btn-next-action');
      if (!textEl || !btnEl) return;

      const maxDone = Math.max(...Array.from(gameState.completedSteps));
      const nextStep = Math.min(7, maxDone + 1);

      if (maxDone === 0) {
        textEl.textContent = `Kapten ${gameState.studentName || ''}, kapal bersandar di Pulau START. Klik "Mulai Berlayar ke Pulau R"!`;
        btnEl.textContent = '⛵ Mulai Berlayar ke Pulau R';
      } else if (maxDone >= 1 && maxDone < 6) {
        const nextIsland = RIASEC_DATA[nextStep - 1];
        textEl.textContent = `Hebat! Pulau sebelumnya selesai. Lanjutkan pelayaran menuju Pulau ${nextIsland.code} (${nextIsland.name}).`;
        btnEl.textContent = `⛵ Berlayar ke Pulau ${nextIsland.code}`;
      } else if (maxDone === 6 && !gameState.completedSteps.has(7)) {
        textEl.textContent = 'Semua 6 pulau RIASEC selesai! Saatnya berlayar menuju Pulau FINISH untuk melihat sertifikatmu!';
        btnEl.textContent = '🏆 Berlayar ke Pulau FINISH';
      } else {
        textEl.textContent = `Selamat Kapten ${gameState.studentName}! Ekspedisi selesai. Klik tombol di kanan untuk melihat sertifikat.`;
        btnEl.textContent = '🏆 Lihat Sertifikat Hasil';
      }
    }

    // =========================================================================
    // 6. NAVIGASI PELAYARAN KAPAL & KARTU TANTANGAN PULAU
    // =========================================================================
    window.handlePrimaryBannerAction = function () {
      const maxDone = Math.max(...Array.from(gameState.completedSteps));
      if (gameState.completedSteps.has(7)) {
        window.handleIslandClick(7);
      } else {
        window.handleIslandClick(Math.min(7, maxDone + 1));
      }
    };

    window.handleIslandClick = function (targetStep) {
      if (gameState.isSailing) return;

      const maxDone = Math.max(...Array.from(gameState.completedSteps));
      const maxUnlocked = Math.min(7, maxDone + 1);

      if (targetStep === 0) {
        if (gameState.currentStep === 0 && maxDone === 0) {
          window.handleIslandClick(1);
        } else {
          sailShipTo(0, () => {
            showModal('start-brief-modal');
          });
        }
        return;
      }

      if (targetStep > maxUnlocked) {
        AudioFX.wrong();
        const reqIsland = RIASEC_DATA[maxUnlocked - 1];
        const statusEl = document.getElementById('status-instruction');
        if (statusEl && reqIsland) {
          statusEl.textContent = `⚠️ Selesaikan Pulau ${reqIsland.code} (${reqIsland.name}) terlebih dahulu sebelum membuka pulau berikutnya!`;
        }
        return;
      }

      sailShipTo(targetStep, () => {
        if (targetStep === 7) {
          gameState.completedSteps.add(7);
          updateHUD();
          openResultModal();
        } else {
          openIslandModal(targetStep);
        }
      });
    };

    function sailShipTo(targetStep, onArrive) {
      const ship = document.getElementById('player-ship');
      const wake = document.getElementById('ship-wake');
      const startPos = SHIP_WAYPOINTS[gameState.currentStep] || SHIP_WAYPOINTS[0];
      const endPos = SHIP_WAYPOINTS[targetStep] || SHIP_WAYPOINTS[0];

      if (!ship || gameState.currentStep === targetStep) {
        gameState.currentStep = targetStep;
        updateHUD();
        if (onArrive) onArrive();
        return;
      }

      gameState.isSailing = true;
      AudioFX.sail();
      if (wake) wake.setAttribute('opacity', '0.85');

      const duration = 680;
      const startTime = performance.now();
      const ctrlX = (startPos.x + endPos.x) / 2;
      const ctrlY = Math.min(startPos.y, endPos.y) - 42;

      function animateFrame(now) {
        const elapsed = now - startTime;
        const t = Math.min(1, elapsed / duration);
        const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

        const x = (1 - ease) * (1 - ease) * startPos.x + 2 * (1 - ease) * ease * ctrlX + ease * ease * endPos.x;
        const y = (1 - ease) * (1 - ease) * startPos.y + 2 * (1 - ease) * ease * ctrlY + ease * ease * endPos.y;

        ship.setAttribute('transform', `translate(${x.toFixed(1)}, ${y.toFixed(1)})`);

        if (t < 1) {
          gameState.sailRafId = requestAnimationFrame(animateFrame);
        } else {
          gameState.isSailing = false;
          gameState.currentStep = targetStep;
          if (wake) wake.setAttribute('opacity', '0');
          AudioFX.arrive();
          updateHUD();
          if (onArrive) onArrive();
        }
      }

      gameState.sailRafId = requestAnimationFrame(animateFrame);
    }

