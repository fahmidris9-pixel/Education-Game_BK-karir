    function submitIslandAnswers(step) {
      const data = RIASEC_DATA[step - 1];
      const valMsg = document.getElementById('modal-validation-msg');
      const requiredScenarios = gameState.mode === 'explore' ? 2 : 3;
      const answeredMap = gameState.interestAnswers[step] || {};

      if (gameState.mode === 'explore' && gameState.quizAnswers[step] === undefined) {
        if (valMsg) valMsg.textContent = '⚠️ Pilih salah satu jawaban kuis pemahaman terlebih dahulu!';
        AudioFX.wrong();
        return;
      }

      for (let i = 0; i < requiredScenarios; i++) {
        if (!answeredMap[i]) {
          if (valMsg) valMsg.textContent = `⚠️ Lengkapi pilihan minat aktivitas nomor ${i + 1}!`;
          AudioFX.wrong();
          return;
        }
      }

      if (valMsg) valMsg.textContent = '';

      // Hitung persentase skor berbobot per aktivitas + kontribusi kuis (jika mode eksplorasi)
      // agar hasil persentase lebih tajam, bervariasi, dan tidak mudah bernilai kembar/sama
      const weights = data.scenarioWeights || [1.16, 1.02, 0.87];
      let weightedSum = 0;
      let maxWeightedSum = 0;

      for (let i = 0; i < requiredScenarios; i++) {
        const w = weights[i] || 1.0;
        const normalizedChoice = (answeredMap[i] - 1) / 3; // Skala 1..4 dipetakan ke 0..1
        weightedSum += normalizedChoice * w;
        maxWeightedSum += w;
      }

      let finalPercent = (weightedSum / maxWeightedSum) * 100;

      if (gameState.mode === 'explore') {
        const isQuizCorrect = gameState.quizAnswers[step] === data.quiz.correctIndex;
        finalPercent = finalPercent * 0.92 + (isQuizCorrect ? 8.0 : 1.5);
      }

      // Tambahkan diferensiasi alami 1 angka di belakang koma berdasarkan urutan minat & indeks pulau
      const patternTieBreaker = ((answeredMap[0] * 3 + (answeredMap[1] || 1) * 2 + step) % 9) * 0.1;
      finalPercent = Math.min(100, Math.max(5, Number((finalPercent + patternTieBreaker).toFixed(1))));

      gameState.scores[data.code] = finalPercent;

      gameState.completedSteps.add(step);
      AudioFX.stopCalmBGM();
      AudioFX.success();
      hideModal('island-modal');
      updateHUD();

      const nextStep = step + 1;
      setTimeout(() => {
        window.handleIslandClick(nextStep);
      }, 220);
    }

